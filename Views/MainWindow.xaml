<Window x:Class="SoundBridge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:SoundBridge.Infrastructure"
        xmlns:models="clr-namespace:SoundBridge.Models"
        Title="声桥 SoundBridge"
        Width="780" Height="466"
        MinWidth="700" MinHeight="440"
        Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        </Style>

        <!-- 主按钮：连接为实心蓝，已连接时降级为中性，避免抢戏 -->
        <Style x:Key="MainActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type models:SinkDevice}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                        Background="{StaticResource IconBgBrush}" VerticalAlignment="Center">
                    <TextBlock Text="&#9834;" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="{StaticResource AccentHoverBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="蓝牙音频接收" FontSize="11" Margin="0,1,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="9" Padding="7,2"
                        Background="{StaticResource OkSoftBrush}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="播放中" FontSize="10.5" Foreground="{StaticResource OkBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18,14,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 连接状态 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="&#9834;" FontFamily="Segoe UI Symbol" FontSize="17" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="声桥" Style="{StaticResource H1}" />
                    <TextBlock Text="手机放歌，电脑出声" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="20" Padding="11,5"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{Binding StatusColorHex, Converter={StaticResource HexToBrush}}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrush}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 唯一的一行状态说明：重连进度、失败原因都落在这里 -->
        <Grid Grid.Row="1" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

            <!-- 自动切默认设备失败时才出现：给一条能走通的路，别只留一句「失败」 -->
            <Button Grid.Column="1" Content="去手动选 →" Style="{StaticResource LinkButton}"
                    FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"
                    Command="{Binding OpenSoundSettingsCommand}"
                    Visibility="{Binding CanFixOutputManually, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- 主体：左设备 / 右配置 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="258" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,2" />

            <!-- 左栏 -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,0,7">
                    <TextBlock Text="可用设备" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <Button Content="刷新" Style="{StaticResource LinkButton}" FontSize="11.5"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox Style="{StaticResource PlainList}"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource DeviceItem}"
                             ItemTemplate="{StaticResource DeviceTemplate}"
                             Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}" />

                    <StackPanel VerticalAlignment="Center" Margin="6,0,10,0"
                                Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="没找到手机" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Caption}"
                                   Margin="0,7,0,0" LineHeight="18" />
                    </StackPanel>
                </Grid>

                <Button Grid.Row="2" Height="42" Margin="0,12,0,0"
                        Style="{StaticResource MainActionButton}"
                        Content="{Binding ActionText}"
                        Command="{Binding PrimaryCommand}" />

                <TextBlock Grid.Row="3" Text="{Binding ActionHint}" Style="{StaticResource Caption}"
                           Margin="0,9,0,0" LineHeight="18" />
            </Grid>

            <!-- 右栏：输出 / 定时 / 开关 -->
            <StackPanel Grid.Column="2" Margin="16,0,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="播放到" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Height="32" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Outputs}"
                              SelectedItem="{Binding SelectedOutput, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="定时暂停" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Width="108" Height="32" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding SleepTimerOptions}"
                              SelectedItem="{Binding SelectedSleepTimer, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 「自定义…」排在选项最上面，用主题色标出来，免得又被当成固定时长之一 -->
                                <TextBlock Text="{Binding Label}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Column="2" Content="铃声提醒" Style="{StaticResource DarkCheckBox}"
                              Margin="14,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding SleepTimerChime, Mode=TwoWay}" />
                    <TextBlock Grid.Column="3" Text="{Binding SleepTimerText}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12" />

                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left"
                          IsChecked="{Binding LimitVolume, Mode=TwoWay}"
                          Content="限制音量，最高 80%" />

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Margin="0,0,26,0"
                              IsChecked="{Binding AutoStart, Mode=TwoWay}" Content="开机自启" />
                    <CheckBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Content="关闭时缩到托盘" />
                    <CheckBox Grid.Row="1" Grid.Column="0" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Margin="0,0,26,0"
                              IsChecked="{Binding AutoReconnect, Mode=TwoWay}" Content="掉线后自动重连" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left"
                              IsChecked="{Binding AutoConnectOnStart, Mode=TwoWay}" Content="启动后自动连接" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 页脚 -->
        <Grid Grid.Row="3" Margin="2,12,2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="使用说明" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                        Command="{Binding OpenHelpCommand}" />
                <Button Content="隐私" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                        Command="{Binding OpenPrivacyCommand}" />
                <Button Content="日志" Style="{StaticResource LinkButton}"
                        Command="{Binding OpenLogCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
