<Window x:Class="SoundBridge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:SoundBridge.Infrastructure"
        xmlns:models="clr-namespace:SoundBridge.Models"
        Title="声桥 SoundBridge"
        Width="880" Height="852"
        MinWidth="780" MinHeight="720"
        Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        </Style>

        <Style x:Key="MainActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type models:SinkDevice}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                        Background="{StaticResource IconBgBrush}" VerticalAlignment="Center">
                    <TextBlock Text="&#9834;" FontFamily="Segoe UI Symbol" FontSize="17"
                               Foreground="{StaticResource AccentHoverBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="蓝牙音频接收" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="9,3"
                        Background="{StaticResource OkSoftBrush}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="正在播放" FontSize="11" Foreground="{StaticResource OkBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Margin="2,0,2,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="&#9834;" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="声桥" Style="{StaticResource H1}" />
                    <TextBlock Text="把手机的声音接到电脑上" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <Button Content="刷新设备" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- 说明 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Body}" Text="只有一个耳机？在手机和电脑之间来回插拔，实在是太麻烦了。" />
                <TextBlock Style="{StaticResource Body}" Margin="0,5,0,0"
                           Text="不想在电脑上装一堆音乐播放器，又想听手机里的会员歌？" />
                <TextBlock Style="{StaticResource BodyStrong}" Margin="0,10,0,0"
                           Text="连上之后，手机负责放，电脑负责响。" />
                <Border Margin="0,12,0,0" Padding="10,0,0,0" BorderThickness="2,0,0,0"
                        BorderBrush="{StaticResource AccentBrush}">
                    <TextBlock Style="{StaticResource Caption}" FontSize="12" LineHeight="19"
                               Text="一副耳机，两个东家 —— 从今天起，它不用再搬家了。" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 设备列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,12,10,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="可用设备" Style="{StaticResource SectionLabel}"
                           Margin="6,2,0,8" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="8,10,0,2"
                           Text="同一时间只能连接一台手机；换设备请先断开。" />
                <Grid>
                    <ListBox Style="{StaticResource PlainList}"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource DeviceItem}"
                             ItemTemplate="{StaticResource DeviceTemplate}"
                             Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}" />

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430"
                                Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="没有找到可以接收音频的设备" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Caption}"
                                   TextAlignment="Center" Margin="0,8,0,0" LineHeight="19" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 主操作 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Height="42" MinWidth="132"
                        Style="{StaticResource MainActionButton}"
                        Content="{Binding ActionText}"
                        Command="{Binding PrimaryCommand}" />

                <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="{Binding ActionHint}" LineHeight="19" />
            </Grid>
        </Border>

        <!-- 状态 -->
        <Grid Grid.Row="4" Margin="6,13,6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding StatusColorHex, Converter={StaticResource HexToBrush}}" />
                <TextBlock Text="连接状态：" FontSize="12.5" Margin="8,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrush}}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="440"
                       TextAlignment="Right" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- 操作步骤 -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="16,12" Margin="0,14,0,0">
            <StackPanel>
                <ToggleButton x:Name="StepsToggle" Style="{StaticResource SectionToggle}"
                              Content="怎么用（3 步）" HorizontalAlignment="Left" />
                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding IsChecked, ElementName=StepsToggle, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7"
                               Text="1. 在 Windows「蓝牙和其他设备」里把手机和这台电脑配对。" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,7"
                               Text="2. 回到这里选中手机，点「连接」。" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="3. 在手机上放音乐或视频，声音就从电脑的耳机 / 音箱出来了。" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="19"
                               Text="提示：蓝牙传输本身有 0.2 秒左右的延迟，听歌无感，看视频时口型会略慢半拍，这是蓝牙协议的物理限制。" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 设置 -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="16,12" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="开机自启" Style="{StaticResource DarkCheckBox}" Margin="0,0,24,0"
                                  IsChecked="{Binding AutoStart, Mode=TwoWay}" />
                        <CheckBox Content="关闭窗口时缩到托盘" Style="{StaticResource DarkCheckBox}" Margin="0,0,24,0"
                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                        <CheckBox Content="断线自动重连" Style="{StaticResource DarkCheckBox}" Margin="0,0,24,0"
                                  IsChecked="{Binding AutoReconnect, Mode=TwoWay}" />
                        <CheckBox Content="启动即连" Style="{StaticResource DarkCheckBox}"
                                  IsChecked="{Binding AutoConnectOnStart, Mode=TwoWay}" />
                    </StackPanel>

                    <Button Content="打开日志" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding OpenLogCommand}" />
                </Grid>

                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="声音输出到" Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />

                    <ComboBox Grid.Column="1" Width="330" HorizontalAlignment="Left"
                              Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Outputs}"
                              SelectedItem="{Binding SelectedOutput, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2" Content="刷新列表" Style="{StaticResource LinkButton}"
                            VerticalAlignment="Center" Margin="10,0,0,0"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" LineHeight="18"
                           Text="连上手机后，声音就固定往这台设备送。设备拔掉时 Windows 不会自动换到别的设备，回这里重选一下即可。" />

                <CheckBox Style="{StaticResource DarkCheckBox}" Margin="0,10,0,0"
                          IsChecked="{Binding LimitVolume, Mode=TwoWay}"
                          Content="连接时把音量压到 80% 以内（防止一放歌就轰耳朵，已经更低则不动）" />

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="定时关闭" Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />

                    <ComboBox Grid.Column="1" Width="126" Style="{StaticResource DarkComboBox}"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding SleepTimerOptions}"
                              SelectedItem="{Binding SelectedSleepTimer, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox Grid.Column="2" Content="到点响一声" Style="{StaticResource DarkCheckBox}"
                              Margin="16,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding SleepTimerChime, Mode=TwoWay}" />

                    <TextBlock Grid.Column="3" Text="{Binding SleepTimerText}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" LineHeight="18"
                           Text="到点自动断开，多数播放器会跟着停下；断开后不会自己重连，想继续听点「连接」即可。少数 App 断开了仍在放，那种只能手动暂停。" />
            </StackPanel>
        </Border>

        <!-- 页脚 -->
        <Grid Grid.Row="7" Margin="6,12,6,0">
            <TextBlock Text="手机和电脑需先在系统蓝牙中完成配对" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}"
                           Margin="0,0,14,0" VerticalAlignment="Center" />
                <Button Content="使用说明" Style="{StaticResource LinkButton}" Margin="0,0,14,0"
                        Command="{Binding OpenHelpCommand}" />
                <Button Content="隐私说明" Style="{StaticResource LinkButton}"
                        Command="{Binding OpenPrivacyCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
