<Window x:Class="SoundBridge.Views.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="声桥 · 隐私说明"
        Width="560" Height="500"
        ResizeMode="CanResize"
        MinWidth="460" MinHeight="360"
        Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,16">
            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="&#128274;" FontFamily="Segoe UI Emoji" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="隐私说明" Style="{StaticResource H1}" />
                <TextBlock Text="不联网，不录音，不留痕。" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="15,13">
                    <StackPanel>
                        <TextBlock Text="数据去了哪里" Style="{StaticResource SectionLabel}" Margin="0,0,0,9" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音频" Style="{StaticResource BodyStrong}" FontSize="12.5" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontSize="12.5" LineHeight="19"
                                       Text="不录制、不缓存、不落盘，直接交给声卡播出去。程序退出后什么都不剩。" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="网络" Style="{StaticResource BodyStrong}" FontSize="12.5" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontSize="12.5" LineHeight="19"
                                       Text="程序里没有任何联网代码，不检查更新，不统计，不发崩溃报告。断网照常用。" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="本地文件" Style="{StaticResource BodyStrong}" FontSize="12.5" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontSize="12.5" LineHeight="19"
                                       Text="就两个：settings.json 存开关和上次的设备，soundbridge.log 记连接过程。位置都在 %APPDATA%\SoundBridge 下。" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日志内容" Style="{StaticResource BodyStrong}" FontSize="12.5" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontSize="12.5" LineHeight="19"
                                       Text="连接状态、错误原因、设备名称。手机的蓝牙地址已打码，只剩前 4 位——你把日志贴出去求助时，别人定位不到具体设备。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="15,13">
                    <StackPanel>
                        <TextBlock Text="想彻底清干净" Style="{StaticResource SectionLabel}" Margin="0,0,0,7" />
                        <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="19"
                                   Text="删掉 %APPDATA%\SoundBridge 这个文件夹，再删程序目录，就干净了。不写注册表——除非你自己打开过「开机自启」，那会多一个启动项。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="2,14,2,0">
            <Button Content="关闭" Width="96" Height="36"
                    Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    IsDefault="True" IsCancel="True" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
