<Window x:Class="SoundBridge.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="声桥 · 使用说明"
        Width="720" Height="660"
        MinWidth="620" MinHeight="420"
        Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 步骤序号：① ② ③ 用圆形徽标代替，扫读比纯文字快 -->
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="Symptom" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style x:Key="Cause" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,12">
            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentBrush}">
                <TextBlock Text="&#9834;" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="第一次用，这一页就够" Style="{StaticResource H1}" />
                <TextBlock Text="先花半分钟确认电脑能不能用，再按三步连。"
                           Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- 30 秒自检 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="先花 30 秒：这台电脑能不能用"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                                <TextBlock Text="1" Style="{StaticResource StepNumber}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="蓝牙适配器要支持「接收」音频（A2DP Sink）" Style="{StaticResource StepTitle}" />
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="19" Margin="0,4,0,0"
                                           Text="多数笔记本内置的 Intel / Realtek 适配器只开放「发送」：能连蓝牙耳机，不能当音箱。" />
                                <Border Margin="0,8,0,0" Padding="11,9" CornerRadius="8"
                                        Background="{StaticResource SurfaceAltBrush}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="19"
                                                   Text="判断：列表里有你的手机 → 支持；一直是空的 → 就是它。" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" LineHeight="18" Margin="0,4,0,0"
                                                   Text="解法：换支持 A2DP Sink 的 USB 适配器（几十块）。软件绕不过去。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                                <TextBlock Text="2" Style="{StaticResource StepNumber}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="系统要 Windows 10 2004（内部版本 19041）或更高" Style="{StaticResource StepTitle}" />
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="19" Margin="0,4,0,0"
                                           Text="低于它 Windows 自己就没有这个能力。按 Win+R 输入 winver 可查版本号。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 三步 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="三步出声" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock Text="1" Style="{StaticResource StepNumber}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="配对手机" Style="{StaticResource StepTitle}" />
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="19" Margin="0,3,0,0"
                                           Text="设置 → 蓝牙和其他设备 → 添加设备 → 蓝牙 → 选你的手机，两边都点「配对」。" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock Text="2" Style="{StaticResource StepNumber}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="回到声桥，选中手机，点「连接」" Style="{StaticResource StepTitle}" />
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="19" Margin="0,3,0,0"
                                           Text="列表里没看到手机就点「刷新」。连接时手机上可能弹一个确认框，点「允许」或「配对」。" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="11.5" LineHeight="18" Margin="0,4,0,0"
                                           Text="有的手机需要反向操作：在手机的蓝牙列表里点一下这台电脑，才会发起音频连接。" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock Text="3" Style="{StaticResource StepNumber}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="在手机上放歌，声音从电脑出来" Style="{StaticResource StepTitle}" />
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" LineHeight="19" Margin="0,3,0,0"
                                           Text="没声音先看「播放到」选对没有，再看系统音量。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 故障对照 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="连不上？先对号入座" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="列表里一直是空的" Style="{StaticResource Symptom}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Cause}"
                                       Text="适配器不支持接收、手机没配对，或者系统版本太低。回到上面两条自检。" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="提示「系统拒绝了」" Style="{StaticResource Symptom}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Cause}"
                                       Text="手机还连着蓝牙耳机或音箱，或者有别的接收软件（BleAudio、Bluetooth Audio Receiver）占着位置。接收端是独占的。" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="连上了，但没声音" Style="{StaticResource Symptom}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Cause}"
                                       Text="「播放到」选错设备最常见。其次看系统音量是否为 0，或者手机静音了。" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="看视频，口型差半拍" Style="{StaticResource Symptom}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Cause}"
                                       Text="蓝牙传输本身有 0.2 秒左右延迟，听歌无感，看视频会明显。协议决定的，改不了。" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="想控制手机上一首 / 下一首" Style="{StaticResource Symptom}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Cause}"
                                       Text="做不到。播放控制走 AVRCP 协议，Windows 没有公开这套接口，只能用手机操作。" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="2,16,2,0">
            <TextBlock x:Name="FooterHint" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Text="这份说明随时能在主界面左下角重新打开。" />
            <Button x:Name="OkButton" Content="开始使用" Width="128" Height="40"
                    Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    IsDefault="True" Click="OnOkClick" />
        </Grid>
    </Grid>
</Window>
