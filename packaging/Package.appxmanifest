<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">

  <!-- 提交到商店时，Name / Publisher 要换成 Partner Center 分配的值（产品标识页可复制） -->
  <Identity Name="SoundBridge.Desktop"
            Publisher="CN=SoundBridge"
            Version="1.1.1.0" />

  <Properties>
    <DisplayName>声桥</DisplayName>
    <PublisherDisplayName>SoundBridge</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="SoundBridge.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
          DisplayName="声桥"
          Description="把手机的声音，交给电脑来放"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- MSIX 里注册表被虚拟化，写 HKCU\...\Run 不会真的自启，
             必须用 startupTask 扩展声明这一个启动任务。 -->
        <uap5:Extension Category="windows.startupTask"
                         Executable="SoundBridge.exe"
                         EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="SoundBridgeStartup"
                            Enabled="false"
                            DisplayName="声桥" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>
</Package>
